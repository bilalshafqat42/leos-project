# Copy this file to .env.local and fill in real values.
# Used by src/app/api/contact/route.js and src/app/api/chatbot/route.js to
# email form submissions via Titan Email SMTP (see src/lib/mailer.js).

# Titan mailbox enquiries are sent from
SMTP_USER=info@leosproject.ae

# That mailbox's password (the same one used to log into Titan webmail)
SMTP_PASSWORD=

# Inbox that should receive site visit enquiries (Contact page / footer form)
CONTACT_TO_EMAIL=info@leosproject.ae

# Inbox that should receive floating chat widget enquiries
CHATBOT_TO_EMAIL=info@leosproject.ae
