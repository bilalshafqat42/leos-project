# Copy this file to .env.local and fill in real values.
# Used by src/app/api/contact/route.js and src/app/api/chatbot/route.js to
# email form submissions.

# Secret API key from your Resend account (https://resend.com/api-keys)
RESEND_API_KEY=

# Inbox that should receive site visit enquiries (Contact page / footer form)
CONTACT_TO_EMAIL=info@leosproject.ae

# Inbox that should receive floating chat widget enquiries
CHATBOT_TO_EMAIL=leos.project.uae@gmail.com

# "From" address — must be on a domain verified in Resend
CONTACT_FROM_EMAIL=enquiries@leosproject.ae
