# Copy this file to .env.local and fill in real values.
# Used by src/app/api/contact/route.js and src/app/api/chatbot/route.js to
# email form submissions via Gmail SMTP (see src/lib/mailer.js).

# Gmail address enquiries are sent from
GMAIL_USER=leos.project.uae@gmail.com

# A Google "App Password" for the account above (NOT your normal Gmail
# password). Generate one at myaccount.google.com/security -> App Passwords
# (requires 2-Step Verification to be turned on for that account first).
GMAIL_APP_PASSWORD=

# Inbox that should receive site visit enquiries (Contact page / footer form)
CONTACT_TO_EMAIL=info@leosproject.ae

# Inbox that should receive floating chat widget enquiries
CHATBOT_TO_EMAIL=leos.project.uae@gmail.com
